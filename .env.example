NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_ENABLE_MOCKS=true
AUTH_MOCKS_ENABLED=true
# Generate an ignored .env using npm run setup:env; never commit the real key.
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
# false is ONLY for localhost HTTP. Use true with HTTPS deployments.
AUTH_COOKIE_SECURE=false
PORT=3006
# Real Python backend mode: AUTH_MOCKS_ENABLED=false and NEXT_PUBLIC_ENABLE_MOCKS=false
# BACKEND_API_URL=https://api.example.com/api
# AUTH_JWKS_URL=https://api.example.com/.well-known/jwks.json
# AUTH_JWT_ISSUER=https://api.example.com
# AUTH_JWT_AUDIENCE=growmer-portal
# APP_ORIGIN=https://portal.example.com

# Optional persistent mock account directory. Docker uses its named volume.
# MOCK_AUTH_DATA_DIR=.mock-data
