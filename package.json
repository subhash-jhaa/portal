{
  "name": "growmer-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts contracts *.ts *.mjs *.json *.yaml README.md",
    "format:check": "prettier --check src tests scripts contracts *.ts *.mjs *.json *.yaml README.md",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "sync:tokens": "node scripts/sync-design-tokens.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "docker:up": "node scripts/docker-up.mjs",
    "test:performance": "node scripts/measure-cold-load.mjs",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run check:tokens && npm test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.55.0",
    "msw": "^3.0.3",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
}
